enum OrgRole {
  ADMIN
  MEMBER
}

enum BoardRole {
  ADMIN
  MEMBER
}


model User {
  id String @id @default(uuid())
  email String @unique
  username String
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  memberships Membership[]
  boardMembers BoardMember[]
  sections Section[] @relation("createdBy")
  createdIssues Issue[] @relation("IssueCreator")
  assignedIssues IssueAssignee[] @relation("Assignee")
  assignementsMade IssueAssignee[] @relation("Assigner")
 }

model Organization {
  id String @id @default(uuid())
  name String 
  userId String
  createdAt DateTime @default(now())

  membership Membership[]
  boards Board[]

  @@unique([userId, name])
}

model Membership {
  id String @id @default(uuid())
  userId String 
  orgId String 
  role OrgRole
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId],references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([userId, orgId])
  @@index([orgId])
}

model Board {
  id String @id @default(uuid())
  name String
  orgId String 
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [orgId], references: [id])

  boardMembers BoardMember[]
  sections Section[]

  @@unique([orgId, name])
}

model BoardMember {
  id String @id @default(uuid())
  userId String
  boardId String
  role BoardRole
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  board Board @relation(fields: [boardId], references: [id])

  @@unique([boardId, userId])
  @@index([userId])
}

model Section {
  id String @id @default(uuid())
  name String
  position Int
  boardId String
  createdBy String
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id])
  user User @relation("createdBy", fields: [createdBy], references: [id])

  issues Issue[]

  @@unique([boardId, name])
}

model Issue {
  id String @id @default(uuid())
  name String
  description String
  sectionId String
  createdById String
  position Int
  createdAt DateTime @default(now())
  endTIme DateTime

  section Section @relation( fields: [sectionId], references: [id])
  user User @relation("IssueCreator", fields: [createdById], references: [id])

  assignedIssues IssueAssignee[]

  @@unique([sectionId, name])
  @@index([createdById])
}

model IssueAssignee {
  id String @id @default(uuid())
  userId String
  assignedById String
  issueId String
  assignedAt   DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id])
  user User @relation("Assignee", fields: [userId], references: [id])
  assignedBy User @relation("Assigner", fields: [assignedById], references: [id] )

  @@unique([userId, issueId])
  @@index([assignedById])
}



