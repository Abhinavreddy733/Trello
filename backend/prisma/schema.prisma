// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrgRole {
  ADMIN
  MEMBER
}

enum BoardRole {
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedOrgs        Organization[]  @relation("OrgOwner")
  memberships      Membership[]
  boardMembers     BoardMember[]
  createdSections  Section[]       @relation("SectionCreator")
  createdIssues    Issue[]         @relation("IssueCreator")
  assignedIssues   IssueAssignee[] @relation("Assignee")
  assignmentsMade  IssueAssignee[] @relation("Assigner")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner       User         @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships Membership[]
  boards      Board[]

  @@unique([ownerId, name])
}

model Membership {
  id       String   @id @default(uuid())
  userId   String
  orgId    String
  role     OrgRole
  joinedAt DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Board {
  id        String   @id @default(uuid())
  name      String
  orgId     String
  createdAt DateTime @default(now())

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  boardMembers BoardMember[]
  sections     Section[]

  @@unique([orgId, name])
}

model BoardMember {
  id       String    @id @default(uuid())
  userId   String
  boardId  String
  role     BoardRole
  joinedAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
}

model Section {
  id          String   @id @default(uuid())
  name        String
  position    Int
  boardId     String
  createdById String?
  createdAt   DateTime @default(now())

  board     Board  @relation(fields: [boardId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("SectionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  issues    Issue[]

  @@unique([boardId, name])
}

model Issue {
  id          String    @id @default(uuid())
  name        String
  description String?
  sectionId   String
  createdById String?
  position    Int
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  section   Section         @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  createdBy User?           @relation("IssueCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignees IssueAssignee[]

  @@index([sectionId, position])
}

model IssueAssignee {
  issueId      String
  userId       String
  assignedById String?
  assignedAt   DateTime @default(now())

  issue      Issue @relation(fields: [issueId], references: [id], onDelete: Restrict)
  user       User  @relation("Assignee", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("Assigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@id([issueId, userId])
  @@index([userId])
}